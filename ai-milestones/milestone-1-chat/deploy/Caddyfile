# Caddy gets and renews the HTTPS certificate for this name by itself, and redirects http to
# https. The name must point at this server before the first start.
{$PULSEGUARD_DOMAIN} {
	# Compress everything except the Ask AI chat's answer stream: a compressor can hold small
	# pieces back until enough bytes collect, and the answer should appear word by word.
	@compress not path_regexp ^/api/ai/conversations/[0-9]+/messages$
	encode @compress zstd gzip
	# Caddy sends X-Forwarded-For and X-Forwarded-Proto, which the app trusts (see
	# application-prod.yaml), so rate limits see real client IPs.
	reverse_proxy app:8080
}
