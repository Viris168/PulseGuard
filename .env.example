# Template for .env — copy to .env and fill in. This file IS committed; .env is not.
#   cp .env.example .env && openssl rand -base64 48

PULSEGUARD_JWT_SECRET=  # openssl rand -base64 48
PULSEGUARD_JWT_ISSUER=pulseguard
PULSEGUARD_JWT_AUDIENCE=pulseguard-api
PULSEGUARD_JWT_ACCESS_EXPIRATION=15m
PULSEGUARD_JWT_REFRESH_EXPIRATION=30d
PULSEGUARD_JWT_CLOCK_SKEW=30s

PULSEGUARD_LOGIN_MAX_ATTEMPTS=5
PULSEGUARD_LOGIN_MAX_ATTEMPTS_PER_IP=20
PULSEGUARD_LOGIN_WINDOW=15m

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:55440/pulseguard
SPRING_DATASOURCE_USERNAME=pulseguard
SPRING_DATASOURCE_PASSWORD=pulseguard

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=1s

# Outbound monitor checks
PULSEGUARD_CHECK_CONNECT_TIMEOUT=5s
PULSEGUARD_CHECK_GRACE_TIMEOUT=2s
PULSEGUARD_CHECK_USER_AGENT=PulseGuard/1.0 (+https://pulseguard.io/bot)
PULSEGUARD_CHECK_MAX_ERROR_LENGTH=500

# Quartz check scheduler
PULSEGUARD_SCHEDULER_ENABLED=true
PULSEGUARD_SCHEDULER_THREADS=20
PULSEGUARD_SCHEDULER_JITTER=30s
PULSEGUARD_SCHEDULER_RECONCILE_ON_STARTUP=true

# Incident state machine
PULSEGUARD_INCIDENT_FAILURE_THRESHOLD=3
PULSEGUARD_INCIDENT_RECOVERY_THRESHOLD=2

# Email alerts (Mailpit locally; Resend/SendGrid SMTP in production)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
PULSEGUARD_NOTIFICATION_FROM=PulseGuard <alerts@pulseguard.local>

# Dashboard stats cache (Redis)
PULSEGUARD_STATS_CACHE_TTL=60s
PULSEGUARD_STATUS_PAGE_CACHE_TTL=60s

# Stripe billing (test mode). Keys: Dashboard -> Developers -> API keys.
# Webhook secret: run `stripe listen --forward-to localhost:8080/api/stripe/webhook`.
# Prices: Product catalog -> Pro / Business -> monthly price id.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me_pro
STRIPE_PRICE_BUSINESS=price_replace_me_business
PULSEGUARD_APP_BASE_URL=http://localhost:5173

# Heartbeat monitors: the public origin in ping URLs, and how often missed pings are looked for
PULSEGUARD_PING_BASE_URL=http://localhost:8080
PULSEGUARD_HEARTBEAT_SWEEP_INTERVAL=30s

# Optional overrides (defaults shown). Emailed account links and their rate limits:
# PULSEGUARD_PASSWORD_RESET_TTL=30m
# PULSEGUARD_EMAIL_VERIFY_TTL=24h
# PULSEGUARD_ACCOUNT_EMAIL_MAX_PER_EMAIL=3
# PULSEGUARD_ACCOUNT_EMAIL_MAX_PER_IP=10
# PULSEGUARD_ACCOUNT_EMAIL_WINDOW=1h
# Failed alert retries: wait before each retry, and how often due retries are checked.
# PULSEGUARD_ALERT_RETRY_BACKOFF=1m,5m,30m
# PULSEGUARD_ALERT_RETRY_SWEEP_INTERVAL=30s

# AI incident summaries and Ask AI (AI_PLAN.md). Off by default: nothing is sent to a provider.
# PULSEGUARD_AI_PROVIDER picks one: none | anthropic | google-genai
#   anthropic    -> ANTHROPIC_API_KEY from console.anthropic.com
#   google-genai -> GOOGLE_AI_API_KEY from aistudio.google.com (free tier may use prompts to
#                   improve Google's products: fine for development, not for customers' data)
PULSEGUARD_AI_PROVIDER=none
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Ask AI's help-docs search embeds the docs with Gemini (AI_MILESTONE_3.md): none | google-genai.
# Needs GOOGLE_AI_API_KEY even when the chat uses Anthropic, which has no embeddings.
PULSEGUARD_AI_EMBEDDING_PROVIDER=none
# Optional overrides (defaults shown):
# PULSEGUARD_AI_EMBEDDING_MODEL=gemini-embedding-2
# PULSEGUARD_AI_SUMMARY_MODEL=claude-haiku-4-5
# PULSEGUARD_AI_GOOGLE_MODEL=gemini-3.1-flash-lite
# PULSEGUARD_AI_OPEN_SUMMARY_TTL=10m
# PULSEGUARD_AI_TIMEOUT=20s
# The longest one Ask AI chat answer may take from start to finish.
# PULSEGUARD_AI_STREAM_TIMEOUT=90s
# Ask AI questions per day on Business ("unlimited"); Free 5 and Pro 100 are fixed in PlanLimits.
# PULSEGUARD_AI_FAIR_USE_DAILY_QUESTIONS=500
