# Server settings for deploy/docker-compose.yml. On the server:
#   cp .env.example .env && chmod 600 .env
# then fill in every "replace_me". This file IS committed; .env is not.
# Database, Redis and the public URLs are set by docker-compose.yml from the values below.

# The public name of the server, without https://, e.g. pulseguard.duckdns.org.
# It must already point at the server's public IP (see DEPLOY.md).
PULSEGUARD_DOMAIN=replace_me.duckdns.org

# Secrets: generate each with   openssl rand -base64 48
PULSEGUARD_JWT_SECRET=replace_me
SPRING_DATASOURCE_PASSWORD=replace_me

# Email alerts through Gmail. The password is a 16-character Google app password (Google
# Account -> Security -> 2-Step Verification on -> App passwords), not your Gmail password.
# Gmail only sends as the account itself, so the From address must be that Gmail address.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace_me@gmail.com
SPRING_MAIL_PASSWORD=replace_me
PULSEGUARD_NOTIFICATION_FROM=PulseGuard <replace_me@gmail.com>

# Stripe (test mode is free). Webhook: Stripe Dashboard -> Developers -> Webhooks -> add
# endpoint https://<PULSEGUARD_DOMAIN>/api/stripe/webhook, then copy its signing secret.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me_pro
STRIPE_PRICE_BUSINESS=price_replace_me_business

# AI incident summaries and Ask AI. Leave PULSEGUARD_AI_PROVIDER=none to keep AI off (nothing is
# sent anywhere). To turn it on, pick one provider and set its key:
#   google-genai -> GOOGLE_AI_API_KEY from aistudio.google.com. Enable billing first: the free tier
#                   may use prompts to improve Google's products, and prompts hold customers' data.
#   anthropic    -> ANTHROPIC_API_KEY from console.anthropic.com. Set a monthly spend limit there.
PULSEGUARD_AI_PROVIDER=none
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Ask AI's help-docs search: none | google-genai (needs GOOGLE_AI_API_KEY, even with Anthropic chat).
PULSEGUARD_AI_EMBEDDING_PROVIDER=none

# Tuning: these defaults are fine for production.
PULSEGUARD_JWT_ISSUER=pulseguard
PULSEGUARD_JWT_AUDIENCE=pulseguard-api
PULSEGUARD_JWT_ACCESS_EXPIRATION=15m
PULSEGUARD_JWT_REFRESH_EXPIRATION=30d
PULSEGUARD_JWT_CLOCK_SKEW=30s

PULSEGUARD_LOGIN_MAX_ATTEMPTS=5
PULSEGUARD_LOGIN_MAX_ATTEMPTS_PER_IP=20
PULSEGUARD_LOGIN_WINDOW=15m

SPRING_DATA_REDIS_TIMEOUT=1s

PULSEGUARD_CHECK_CONNECT_TIMEOUT=5s
PULSEGUARD_CHECK_GRACE_TIMEOUT=2s
PULSEGUARD_CHECK_USER_AGENT=PulseGuard/1.0 (+https://pulseguard.io/bot)
PULSEGUARD_CHECK_MAX_ERROR_LENGTH=500

PULSEGUARD_SCHEDULER_ENABLED=true
PULSEGUARD_SCHEDULER_THREADS=20
PULSEGUARD_SCHEDULER_JITTER=30s
PULSEGUARD_SCHEDULER_RECONCILE_ON_STARTUP=true

PULSEGUARD_INCIDENT_FAILURE_THRESHOLD=3
PULSEGUARD_INCIDENT_RECOVERY_THRESHOLD=2

PULSEGUARD_STATS_CACHE_TTL=60s
PULSEGUARD_STATUS_PAGE_CACHE_TTL=60s
PULSEGUARD_HEARTBEAT_SWEEP_INTERVAL=30s
