# Template for .env.local — copy it and fill in. This file IS committed; .env.local is not (*.local in .gitignore).
#   cp .env.example .env.local
# Vite only exposes variables prefixed with VITE_ to the browser, and everything exposed ships to
# every visitor. Only publishable values belong here: never sk_..., whsec_... or any other secret.

# Stripe publishable key (Dashboard -> Developers -> API keys), pk_test_... locally.
# Not used by the current redirect-to-Checkout flow; needed only for Stripe.js (Elements, embedded Checkout).
VITE_STRIPE_PUBLISHABLE_KEY=
